# SAIGBOX Environment Configuration

# Database
DATABASE_URL=sqlite:///./saigbox.db

# JWT Secret (generate a secure random string)
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.saigbox.com/api/auth/google/callback

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant, or your specific tenant ID
MICROSOFT_REDIRECT_URI=https://api.saigbox.com/api/auth/microsoft/callback

# Anthropic API (for SAIG Assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Application Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Settings (add your domains)
CORS_ORIGINS=https://saigbox.com,https://www.saigbox.com,https://api.saigbox.com,http://localhost:3000,http://localhost:8000

# Email Service Settings
MAX_EMAIL_SYNC_PER_REQUEST=50
EMAIL_SYNC_INTERVAL_SECONDS=30

# Session Settings
SESSION_SECRET_KEY=your-session-secret-key
SESSION_EXPIRE_HOURS=24

# Feature Flags
ENABLE_OUTLOOK_SUPPORT=true
ENABLE_GMAIL_SUPPORT=true
ENABLE_URGENCY_DETECTION=true
ENABLE_AUTO_ACTION_ITEMS=true