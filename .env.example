# SAIGBOX Environment Configuration

# Database
DATABASE_URL=sqlite:///./saigbox.db

# JWT Secret (generate a secure random string)
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.saigbox.com/api/auth/google/callback

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant, or your specific tenant ID
MICROSOFT_REDIRECT_URI=https://api.saigbox.com/api/auth/microsoft/callback

# AI API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key  # For AI-powered sales features

# Application Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# CORS Settings (add your domains)
CORS_ORIGINS=https://saigbox.com,https://www.saigbox.com,https://api.saigbox.com,http://localhost:3000,http://localhost:8000

# Email Service Settings
MAX_EMAIL_SYNC_PER_REQUEST=50
EMAIL_SYNC_INTERVAL_SECONDS=30

# Session Settings
SESSION_SECRET_KEY=your-session-secret-key
SESSION_EXPIRE_HOURS=24

# Feature Flags
ENABLE_OUTLOOK_SUPPORT=true
ENABLE_GMAIL_SUPPORT=true
ENABLE_URGENCY_DETECTION=true
ENABLE_AUTO_ACTION_ITEMS=true

# Background Email Sync Settings
SYNC_INTERVAL_SECONDS=30
SYNC_BATCH_SIZE=25

# Semantic Search Settings
SEMANTIC_SEARCH_CANDIDATES=200
USE_AI_RANKING=true

# Action Item Extraction Settings
ACTION_CONFIDENCE_THRESHOLD=70

# ===== AWS STORAGE CONFIGURATION =====
# Environment Setting
ENVIRONMENT=development  # Change to 'production' when deploying

# AWS Storage Services Credentials
# These are separate from Bedrock credentials and need broader permissions
# for S3, DynamoDB, Secrets Manager, CloudWatch, etc.
AWS_STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
AWS_STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key

# AWS Region
AWS_REGION=us-east-1

# S3 Bucket Configuration
S3_BUCKET_DEVELOPMENT=saigbox-user-data-dev
S3_BUCKET_PRODUCTION=saigbox-user-data-prod

# RDS PostgreSQL Configuration (Production)
RDS_ENDPOINT_PRODUCTION=your-rds-instance.us-east-1.rds.amazonaws.com
DB_HOST=localhost  # for development
DB_PORT=5432
DB_NAME=saigbox
DB_USERNAME=saigbox_admin
DB_PASSWORD=your-secure-database-password

# Redis/ElastiCache Configuration
REDIS_ENDPOINT_PRODUCTION=your-elasticache.us-east-1.cache.amazonaws.com
REDIS_HOST=localhost  # for development
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# KMS Key for Encryption (optional)
KMS_KEY_ID=arn:aws:kms:us-east-1:xxxxxxxxxxxx:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AWS Bedrock Configuration (for SAIG AI)
# Note: These are separate from storage credentials
AWS_ACCESS_KEY_ID=your-bedrock-access-key-id
AWS_SECRET_ACCESS_KEY=your-bedrock-secret-access-key